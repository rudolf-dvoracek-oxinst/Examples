<?xml version="1.0" encoding="UTF-8"?>
<Feature SiLA2Version="1.0" FeatureVersion="1.0" Originator="oxfordinstruments"
         Category="examples"
         xmlns="http://www.sila-standard.org"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.sila-standard.org https://gitlab.com/SiLA2/sila_base/raw/master/schema/FeatureDefinition.xsd">
  <Identifier>TemperatureFeature</Identifier>
  <DisplayName>Temperature Feature</DisplayName>
  <Description>Example temperature feature supporting single measurements and a current temperature property.</Description>

  <Command>
    <Identifier>MeasureTemperature</Identifier>
    <DisplayName>Measure Temperature</DisplayName>
    <Description>Perform a one-off temperature measurement and update the CurrentTemperature property.</Description>
    <Observable>No</Observable>
  </Command>

  <Property>
    <Identifier>CurrentTemperature</Identifier>
    <DisplayName>Current Temperature</DisplayName>
    <Description>Latest temperature reading.</Description>
    <Observable>Yes</Observable>
    <DataType>
      <Structure>
        <Element>
          <Identifier>ValueCelsius</Identifier>
          <DisplayName>Temperature (°C)</DisplayName>
          <Description>Measured temperature value expressed in degrees Celsius.</Description>
          <DataType>
            <Constrained>
              <DataType>
                <Basic>Real</Basic>
              </DataType>
              <Constraints>
                <Unit>
                  <Label>°C</Label>
                  <Factor>1</Factor>
                  <Offset>273.15</Offset>
                  <UnitComponent>
                    <SIUnit>Kelvin</SIUnit>
                    <Exponent>1</Exponent>
                  </UnitComponent>
                </Unit>
              </Constraints>
            </Constrained>
          </DataType>
        </Element>
        <Element>
          <Identifier>TimestampUnixMs</Identifier>
          <DisplayName>Timestamp (Unix ms)</DisplayName>
          <Description>Unix time in milliseconds when the sample was taken.</Description>
          <DataType>
            <Basic>Integer</Basic>
          </DataType>
        </Element>
      </Structure>
    </DataType>
  </Property>
</Feature>